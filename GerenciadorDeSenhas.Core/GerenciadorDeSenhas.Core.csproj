<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GerenciadorDeSenhas</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Só a KDF. Os drivers de banco ficam no projeto .Integracoes, para não
         entrarem no CLI nem em qualquer consumidor que só usa o cofre local. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GerenciadorDeSenhas.Integracoes" />
    <InternalsVisibleTo Include="GerenciadorDeSenhas.Testes" />
  </ItemGroup>

</Project>
