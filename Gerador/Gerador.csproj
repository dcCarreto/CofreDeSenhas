<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>GeradorDeSenhas</AssemblyName>
    <RootNamespace>CofreDeSenhas.Gerador</RootNamespace>
    <!-- Sem número de versão, igual ao Cofre: carimbo de data por atualização.
         O pipeline passa -p:Version com a data da release; local vale a data de hoje. -->
    <Version>$([System.DateTime]::UtcNow.ToString('yyyy.M.d'))</Version>
    <Product>Gerador de Senhas</Product>
    <Authors>Denis Cristino Cantagallo Carreto</Authors>
    <Company>Denis Cristino Cantagallo Carreto</Company>
    <Description>Gerador de senhas e frases-senha autônomo, sem cofre, com as mesmas regras de geração do Cofre de Senhas.</Description>
    <Copyright>Copyright © 2026 Denis Cristino Cantagallo Carreto</Copyright>

    <!-- Mesmo ícone do Cofre de Senhas; ignorado no Linux -->
    <ApplicationIcon>..\App\app.ico</ApplicationIcon>

    <!-- Janelas só têm construtor com parâmetros; não usamos o loader dinâmico de XAML -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>

    <!-- Publicação em arquivo único (portátil e instalador no Windows): as DLLs
         nativas do Avalonia/Skia (libSkiaSharp, libHarfBuzzSharp, av_libglesv2) e
         das demais dependências vão dentro do .exe e são extraídas na primeira
         execução. Sem isto elas ficavam soltas ao lado do .exe na pasta de
         publicação; o instalador funcionava porque copia a pasta inteira, mas o
         portátil — só o .exe — quebrava na inicialização com DllNotFoundException
         ao carregar o SkiaSharp. Só tem efeito com PublishSingleFile=true. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App\App.csproj" />
    <ProjectReference Include="..\GerenciadorDeSenhas.Core\GerenciadorDeSenhas.Core.csproj" />
  </ItemGroup>

</Project>
