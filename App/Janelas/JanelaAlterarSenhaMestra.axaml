<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CofreDeSenhas.Janelas.JanelaAlterarSenhaMestra"
        Title="{DynamicResource Master.ChangeTitle}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner">

  <Border CornerRadius="12"
          ClipToBounds="True"
          Background="{DynamicResource CardBackground}"
          BorderBrush="{DynamicResource CardBorder}"
          BorderThickness="1">

    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="56"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,0,0,1"
              PointerPressed="Arrastar">
        <Grid>
          <TextBlock Text="{DynamicResource Master.ChangeTitle}"
                     FontSize="17" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="1"
                     Margin="24,0,0,0" />
          <Button Classes="fechar-dialogo" Content="✕"
                  AutomationProperties.Name="{DynamicResource Access.Close}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,14,0"
                  Click="Cancelar_Click" />
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom"
              Height="72"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,1,0,0">
        <Grid Margin="24,0">
          <Button Name="BtnAlterar" Classes="primario" Content="{DynamicResource Common.Change}"
                  Width="200" Height="40"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Click="Alterar_Click" />
          <Button Classes="secundario" Content="{DynamicResource Common.Cancel}"
                  Width="150" Height="40"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Click="Cancelar_Click" />
        </Grid>
      </Border>

      <StackPanel Margin="24,14,24,10" Spacing="4">
        <TextBlock Text="{DynamicResource Master.CurrentPassword}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBox Name="TxtAtual" Classes="campo revealPasswordButton" PasswordChar="●" Margin="0,0,0,10"
                 AutomationProperties.Name="{DynamicResource Master.CurrentPassword}"
                 AutomationProperties.HelpText="{DynamicResource A11y.PasswordFieldHelp}"
                 AutomationProperties.IsRequiredForForm="True" />

        <TextBlock Text="{DynamicResource Master.NewPassword}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBox Name="TxtNova" Classes="campo revealPasswordButton" PasswordChar="●" Margin="0,0,0,10"
                 AutomationProperties.Name="{DynamicResource Master.NewPassword}"
                 AutomationProperties.HelpText="{DynamicResource A11y.PasswordFieldHelp}"
                 AutomationProperties.IsRequiredForForm="True" />

        <TextBlock Text="{DynamicResource Master.ConfirmNewPassword}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBox Name="TxtConfirmar" Classes="campo revealPasswordButton" PasswordChar="●" Margin="0,0,0,8"
                 AutomationProperties.Name="{DynamicResource Master.ConfirmNewPassword}"
                 AutomationProperties.HelpText="{DynamicResource A11y.PasswordFieldHelp}"
                 AutomationProperties.IsRequiredForForm="True" />

        <TextBlock Name="LblErro"
                   FontSize="12"
                   Foreground="{DynamicResource StrengthWeak}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive"
                   MinHeight="20" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
