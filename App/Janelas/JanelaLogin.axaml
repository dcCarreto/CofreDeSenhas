<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:CofreDeSenhas.Controles"
        x:Class="CofreDeSenhas.Janelas.JanelaLogin"
        Title="{DynamicResource App.Title}"
        Width="800" Height="700"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">

  <Border Name="Moldura"
          CornerRadius="12"
          ClipToBounds="True"
          Background="{DynamicResource WorkspaceBackground}"
          BorderBrush="{DynamicResource CardBorder}"
          BorderThickness="1"
          PointerPressed="Arrastar">

    <Grid>
      <Grid Margin="18" ColumnDefinitions="360,18,*">
        <Border Grid.Column="0"
                CornerRadius="12"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                BoxShadow="0 3 16 0 #21262840">
          <c:GeradorSenha Name="Gerador" />
        </Border>

        <Border Grid.Column="2"
                CornerRadius="12"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                BoxShadow="0 3 16 0 #21262840">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      Margin="40" MaxWidth="360">
            <Image Source="/Ativos/app.png" Width="64" Height="64" HorizontalAlignment="Center" />

            <TextBlock Text="{DynamicResource App.Title}"
                       FontSize="23" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,4" />

            <TextBlock Name="LblSubtitulo"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,26" />

            <ComboBox Name="CmbIdioma"
                      Classes="campo"
                      Height="36"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,18" />

            <TextBlock Text="{DynamicResource Login.MasterPassword}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,6" />
            <TextBox Name="TxtSenha"
                     Classes="campo revealPasswordButton"
                     PasswordChar="●"
                     MinHeight="42" />

            <StackPanel Name="PainelConfirmar" IsVisible="False" Margin="0,14,0,0">
              <TextBlock Text="{DynamicResource Login.ConfirmPassword}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondary}"
                         Margin="0,0,0,6" />
              <TextBox Name="TxtConfirmar"
                       Classes="campo revealPasswordButton"
                       PasswordChar="●"
                       MinHeight="42" />
            </StackPanel>

            <TextBlock Name="LblErro"
                       FontSize="12"
                       Foreground="{DynamicResource StrengthWeak}"
                       TextWrapping="Wrap"
                       MinHeight="20"
                       Margin="0,10,0,10" />

            <Button Name="BtnPrincipal"
                    Classes="primario"
                    Height="44"
                    HorizontalAlignment="Stretch"
                    Click="Principal_Click" />

            <Button Name="BtnBiometria"
                    Classes="secundario"
                    Height="42"
                    HorizontalAlignment="Stretch"
                    Margin="0,10,0,0"
                    IsVisible="False"
                    Click="Biometria_Click">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <PathIcon Width="15" Height="15"
                          Data="M12 2 C16.42 2 20 5.58 20 10 L20 12 L18 12 L18 10 C18 6.69 15.31 4 12 4 C8.69 4 6 6.69 6 10 C6 13.31 8.69 16 12 16 C13.1 16 14.13 15.71 15.02 15.2 L16.03 16.94 C14.84 17.61 13.47 18 12 18 C7.58 18 4 14.42 4 10 C4 5.58 7.58 2 12 2 Z M12 6 C14.21 6 16 7.79 16 10 L16 12 L14 12 L14 10 C14 8.9 13.1 8 12 8 C10.9 8 10 8.9 10 10 C10 11.1 10.9 12 12 12 L12 14 C9.79 14 8 12.21 8 10 C8 7.79 9.79 6 12 6 Z M17 14 L22 14 L22 19 L20 19 L20 16 L17 16 Z" />
                <TextBlock Name="LblBiometria" Text="{DynamicResource Login.WindowsHello}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <TextBlock Name="LblBiometriaHint"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Button Name="BtnFechar"
              Classes="fechar-dialogo"
              Content="✕"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,26,26,0"
              Click="Fechar_Click" />
    </Grid>
  </Border>
</Window>
