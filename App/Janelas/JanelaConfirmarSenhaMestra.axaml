<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CofreDeSenhas.Janelas.JanelaConfirmarSenhaMestra"
        Title="Confirmar senha mestra"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner">

  <Border CornerRadius="{StaticResource RadiusDialogo}"
          ClipToBounds="True"
          Background="{DynamicResource CardBackground}"
          BorderBrush="{DynamicResource CardBorder}"
          BorderThickness="1">

    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="56"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,0,0,1"
              PointerPressed="Arrastar">
        <Grid>
          <TextBlock Name="LblTitulo"
                     Text="{DynamicResource Qr.RegenerateTitle}"
                     Classes="titulo"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="1"
                     Margin="24,0,0,0" />
          <Button Classes="fechar-dialogo"
                  AutomationProperties.Name="{DynamicResource Access.Close}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,14,0"
                  Click="Cancelar_Click">
            <Path Classes="line-icon" Width="14" Height="14" Data="{StaticResource IconeFechar}" />
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom"
              Height="72"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,1,0,0">
        <Grid Margin="24,0">
          <Button Name="BtnConfirmar" Classes="primario" Content="{DynamicResource Qr.GenerateButton}"
                  Width="200" Height="40"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Click="Gerar_Click" />
          <Button Classes="secundario" Content="{DynamicResource Common.Cancel}"
                  Width="150" Height="40"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Click="Cancelar_Click" />
        </Grid>
      </Border>

      <StackPanel Margin="24,16,24,10" Spacing="4">
        <TextBlock Name="LblInstrucao"
                   Text="{DynamicResource Qr.RegenerateInstruction}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock Text="{DynamicResource Login.MasterPassword}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBox Name="TxtSenha" Classes="campo revealPasswordButton" PasswordChar="●" Margin="0,0,0,8"
                 AutomationProperties.Name="{DynamicResource Login.MasterPassword}"
                 AutomationProperties.HelpText="{DynamicResource A11y.PasswordFieldHelp}"
                 AutomationProperties.IsRequiredForForm="True" />

        <TextBlock Name="LblErro"
                   FontSize="12"
                   Foreground="{DynamicResource StrengthWeak}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive"
                   MinHeight="20" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
