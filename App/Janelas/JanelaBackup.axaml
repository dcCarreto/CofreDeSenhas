<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CofreDeSenhas.Janelas.JanelaBackup"
        Title="{DynamicResource Backup.Title}"
        Width="480"
        Height="580"
        MinWidth="420"
        MinHeight="420"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner">

  <Border CornerRadius="{StaticResource RadiusDialogo}"
          ClipToBounds="True"
          Background="{DynamicResource CardBackground}"
          BorderBrush="{DynamicResource CardBorder}"
          BorderThickness="1">

    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="56"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,0,0,1"
              PointerPressed="Arrastar">
        <Grid>
          <TextBlock Text="{DynamicResource Backup.Title}"
                     Classes="titulo"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="1"
                     Margin="24,0,0,0" />
          <Button Classes="fechar-dialogo"
                  AutomationProperties.Name="{DynamicResource Access.Close}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,14,0"
                  Click="Fechar_Click">
            <Path Classes="line-icon" Width="14" Height="14" Data="{StaticResource IconeFechar}" />
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom"
              Height="72"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
          <Button Classes="secundario" Content="{DynamicResource Common.Close}"
                  MinWidth="120" Height="40" Click="Fechar_Click" />
        </StackPanel>
      </Border>

      <ScrollViewer>
        <StackPanel Margin="24,18,24,16" Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Text="{DynamicResource Backup.Frequency}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
            <ComboBox Name="CmbFrequencia" Classes="campo" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{DynamicResource Backup.Frequency}"
                      SelectionChanged="Frequencia_Alterada" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{DynamicResource Backup.MaxKept}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
            <ComboBox Name="CmbMaximo" Classes="campo" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{DynamicResource Backup.MaxKept}"
                      SelectionChanged="Maximo_Alterado" />
          </StackPanel>

          <Border Background="{DynamicResource InputBackground}"
                  BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusInput}" Padding="12,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Name="LblUltimoBackup" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Grid.Column="1" Classes="secundario" Content="{DynamicResource Backup.Now}"
                      Height="34" Margin="10,0,0,0" Click="BackupAgora_Click"
                      AutomationProperties.Name="{DynamicResource Backup.Now}" />
            </Grid>
          </Border>

          <TextBlock Name="LblAvisoBanco" Text="{DynamicResource Backup.RestoreDisabledDbConnected}"
                      FontSize="12" Foreground="{DynamicResource StrengthMedium}" TextWrapping="Wrap"
                      IsVisible="False" />

          <TextBlock Text="{DynamicResource Backup.Available}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" />
          <TextBlock Name="LblSemBackups" Text="{DynamicResource Backup.None}" FontSize="13"
                     Foreground="{DynamicResource TextSecondary}" IsVisible="False" />
          <StackPanel Name="PainelBackups" Spacing="8" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
