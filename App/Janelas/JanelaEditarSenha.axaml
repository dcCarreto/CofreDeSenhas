<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CofreDeSenhas.Janelas.JanelaEditarSenha"
        Title="{DynamicResource Entry.EditTitle}"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner">

  <Border CornerRadius="{StaticResource RadiusDialogo}"
          ClipToBounds="True"
          Background="{DynamicResource CardBackground}"
          BorderBrush="{DynamicResource CardBorder}"
          BorderThickness="1">

    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="56"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,0,0,1"
              PointerPressed="Arrastar">
        <Grid>
          <TextBlock Name="LblTitulo"
                     Classes="titulo"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="1"
                     Margin="24,0,60,0"
                     TextTrimming="CharacterEllipsis" />
          <Button Classes="fechar-dialogo"
                  AutomationProperties.Name="{DynamicResource Access.Close}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,14,0"
                  Click="Cancelar_Click">
            <Path Classes="line-icon" Width="14" Height="14" Data="{StaticResource IconeFechar}" />
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom"
              Height="72"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
          <Button Classes="primario" Content="{DynamicResource Common.Save}"
                  MinWidth="140" Height="40" Click="Salvar_Click" />
          <Button Classes="secundario" Content="{DynamicResource Common.Cancel}"
                  MinWidth="120" Height="40" Click="Cancelar_Click" />
        </StackPanel>
      </Border>

      <StackPanel Margin="24,18,24,16" Spacing="4">
        <TextBlock Text="{DynamicResource Entry.ServiceName}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBox Name="TxtNomeServico" Classes="campo" Margin="0,0,0,14"
                 AutomationProperties.Name="{DynamicResource Entry.ServiceName}"
                 AutomationProperties.IsRequiredForForm="True" />

        <TextBlock Text="{DynamicResource Entry.UserEmail}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBox Name="TxtUsuario" Classes="campo" Margin="0,0,0,14"
                 AutomationProperties.Name="{DynamicResource Entry.UserEmail}"
                 AutomationProperties.IsRequiredForForm="True" />

        <TextBlock Text="{DynamicResource Entry.PasswordKeepCurrent}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBox Name="TxtSenha" Classes="campo revealPasswordButton" PasswordChar="●" Margin="0,0,0,8"
                 AutomationProperties.Name="{DynamicResource Entry.PasswordKeepCurrent}"
                 AutomationProperties.HelpText="{DynamicResource A11y.PasswordFieldHelp}" />

        <Expander Name="ExpHistorico" IsVisible="False" IsExpanded="False"
                  HorizontalAlignment="Stretch" Margin="0,0,0,14">
          <StackPanel Name="PainelHistorico" Spacing="10" />
        </Expander>

        <TextBlock Text="{DynamicResource Entry.TotpRemove}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBox Name="TxtTotp" Classes="campo"
                 AutomationProperties.Name="{DynamicResource Entry.TotpRemove}"
                 AutomationProperties.HelpText="{DynamicResource A11y.OptionalField}"
                 Watermark="{DynamicResource Entry.TotpWatermark}" Margin="0,0,0,8" />
        <Border Name="PainelTotp" IsVisible="False"
                Background="{DynamicResource InputBackground}"
                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusInput}" Padding="12,8" Margin="0,0,0,14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Name="LblCodigoTotp" FontFamily="{DynamicResource FonteMono}"
                       FontSize="20" FontWeight="Bold" LetterSpacing="1"
                       Foreground="{DynamicResource AccentPrimary}" VerticalAlignment="Center"
                       AutomationProperties.Name="{DynamicResource A11y.TotpPreview}"
                       AutomationProperties.LiveSetting="Polite" />
            <Grid Grid.Column="2" Width="26" Height="26" VerticalAlignment="Center">
              <Ellipse Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Stroke="{DynamicResource TrailInactive}" StrokeThickness="2.5" />
              <Path Name="AnelTotp" Stroke="{DynamicResource AccentPrimary}"
                    StrokeThickness="2.5" StrokeLineCap="Round" />
            </Grid>
          </Grid>
        </Border>

        <TextBlock Text="{DynamicResource Entry.Category}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <ComboBox Name="CmbCategoria" Classes="campo" HorizontalAlignment="Stretch" Margin="0,0,0,14"
                  AutomationProperties.Name="{DynamicResource Entry.Category}"
                  AutomationProperties.IsRequiredForForm="True" />

        <TextBlock Name="LblCategoriaPersonalizada" Text="{DynamicResource Entry.CustomCategory}" IsVisible="False"
                   FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBox Name="TxtCategoriaPersonalizada" Classes="campo" IsVisible="False"
                 AutomationProperties.Name="{DynamicResource Entry.CustomCategory}"
                 Watermark="{DynamicResource Entry.CustomCategoryWatermark}" Margin="0,0,0,14" />

        <TextBlock Text="{DynamicResource Entry.UrlOptional}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBox Name="TxtUrl" Classes="campo" Margin="0,0,0,14"
                 AutomationProperties.Name="{DynamicResource Entry.UrlOptional}"
                 AutomationProperties.HelpText="{DynamicResource A11y.OptionalField}" />

        <TextBlock Text="{DynamicResource Entry.NotesOptional}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBox Name="TxtNotas" Classes="campo" AcceptsReturn="True" Height="64"
                 AutomationProperties.Name="{DynamicResource Entry.NotesOptional}"
                 AutomationProperties.HelpText="{DynamicResource A11y.OptionalField}" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
