<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CofreDeSenhas.Janelas.JanelaSincronizacao"
        Title="{DynamicResource Sync.Title}"
        Width="480"
        SizeToContent="Height"
        MinWidth="420"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        RenderOptions.BitmapInterpolationMode="HighQuality">

  <Border CornerRadius="{StaticResource RadiusDialogo}"
          ClipToBounds="True"
          Background="{DynamicResource CardBackground}"
          BorderBrush="{DynamicResource CardBorder}"
          BorderThickness="1">

    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="56"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,0,0,1"
              PointerPressed="Arrastar">
        <Grid>
          <TextBlock Text="{DynamicResource Sync.Title}"
                     Classes="titulo"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="1"
                     Margin="24,0,60,0"
                     TextTrimming="CharacterEllipsis" />
          <Button Classes="fechar-dialogo"
                  AutomationProperties.Name="{DynamicResource Access.Close}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,14,0"
                  Click="Fechar_Click">
            <Image Width="22" Height="22" Stretch="Uniform" Source="avares://CofreDeSenhas/Ativos/Icones/IconeFechar.png" />
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom"
              Height="72"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
          <Button Classes="secundario" Content="{DynamicResource Common.Close}"
                  MinWidth="120" Height="40" Click="Fechar_Click" />
        </StackPanel>
      </Border>

      <StackPanel Margin="24,18,24,16" Spacing="14">
        <TextBlock Text="{DynamicResource Sync.Explanation}" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />

        <StackPanel Name="PainelInativo" Spacing="10">
          <Button Name="BtnAtivar" Classes="primario" Content="{DynamicResource Sync.Enable}"
                  Height="40" Click="Ativar_Click"
                  AutomationProperties.Name="{DynamicResource Sync.Enable}" />
        </StackPanel>

        <StackPanel Name="PainelAtivo" Spacing="14" IsVisible="False">
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Sync.Folder}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Name="LblPasta" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Sync.Frequency}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
            <ComboBox Name="CmbFrequencia" Classes="campo" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{DynamicResource Sync.Frequency}"
                      SelectionChanged="Frequencia_Alterada" />
          </StackPanel>

          <Border Background="{DynamicResource InputBackground}"
                  BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusInput}" Padding="12,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Name="LblUltimaSincronizacao" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Grid.Column="1" Classes="secundario" Content="{DynamicResource Sync.Now}"
                      MinHeight="34" Margin="10,0,0,0" Click="SincronizarAgora_Click"
                      AutomationProperties.Name="{DynamicResource Sync.Now}" />
            </Grid>
          </Border>

          <Button Name="BtnDesativar" Classes="secundario" Content="{DynamicResource Sync.Disable}"
                  MinHeight="34" HorizontalAlignment="Left" Click="Desativar_Click"
                  AutomationProperties.Name="{DynamicResource Sync.Disable}" />
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
