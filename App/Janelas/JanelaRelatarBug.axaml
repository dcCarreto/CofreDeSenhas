<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:CofreDeSenhas.Controles"
        x:Class="CofreDeSenhas.Janelas.JanelaRelatarBug"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        Title="{DynamicResource BugReport.Title}">

  <Border CornerRadius="{StaticResource RadiusDialogo}"
          ClipToBounds="True"
          Background="{DynamicResource CardBackground}"
          BorderBrush="{DynamicResource CardBorder}"
          BorderThickness="1">

    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="56"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,0,0,1"
              PointerPressed="Arrastar">
        <Grid>
          <TextBlock Text="{DynamicResource BugReport.Title}"
                     Classes="titulo"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="1"
                     Margin="24,0,60,0" />
          <Button Classes="fechar-dialogo"
                  AutomationProperties.Name="{DynamicResource Access.Close}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,14,0"
                  Click="Cancelar_Click">
            <c:Icone Width="{StaticResource TamIconeToolbar}" Height="{StaticResource TamIconeToolbar}" Chave="IconeFechar" />
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom"
              Height="72"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
          <Button Name="BtnEnviar" Classes="primario" Content="{DynamicResource BugReport.Send}"
                  AutomationProperties.Name="{DynamicResource BugReport.Send}"
                  MinWidth="140" Height="40" Click="Enviar_Click" />
          <Button Classes="secundario" Content="{DynamicResource Common.Cancel}"
                  MinWidth="120" Height="40" Click="Cancelar_Click" />
        </StackPanel>
      </Border>

      <StackPanel Margin="24,18,24,16" Spacing="4">
        <TextBlock Text="{DynamicResource BugReport.Info}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock Text="{DynamicResource BugReport.Description}" Classes="legenda" />
        <TextBox Name="TxtDescricao" Classes="campo" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="140" MaxLength="5000" VerticalContentAlignment="Top"
                 AutomationProperties.Name="{DynamicResource BugReport.Description}"
                 AutomationProperties.IsRequiredForForm="True" />

        <Expander Header="{DynamicResource BugReport.ShowDiagnostics}" Margin="0,10,0,0"
                  HorizontalAlignment="Stretch">
          <TextBox Name="TxtRelatorio" Classes="campo" IsReadOnly="True" TextWrapping="NoWrap"
                   Height="180" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                   AutomationProperties.Name="{DynamicResource BugReport.ShowDiagnostics}" />
        </Expander>

        <TextBlock Name="LblErro"
                   FontSize="12"
                   Foreground="{DynamicResource StrengthWeak}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive"
                   MinHeight="34" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
