<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CofreDeSenhas.Janelas.JanelaSelecionarBanco"
        Title="{DynamicResource Db.SelectTitle}"
        Width="536"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        RenderOptions.BitmapInterpolationMode="HighQuality">

  <Border CornerRadius="{StaticResource RadiusDialogo}"
          ClipToBounds="True"
          Background="{DynamicResource CardBackground}"
          BorderBrush="{DynamicResource CardBorder}"
          BorderThickness="1">

    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="56"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,0,0,1"
              PointerPressed="Arrastar">
        <Grid>
          <TextBlock Text="{DynamicResource Db.SelectTitle}"
                     Classes="titulo"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="1"
                     Margin="24,0,60,0"
                     TextTrimming="CharacterEllipsis" />
          <Button Classes="fechar-dialogo"
                  AutomationProperties.Name="{DynamicResource Access.Close}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,14,0"
                  Click="Cancelar_Click">
            <Image Width="22" Height="22" Stretch="Uniform" Source="avares://CofreDeSenhas/Ativos/Icones/IconeFechar.png" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Margin="24,18,24,16" Spacing="14">
        <TextBlock Text="{DynamicResource Db.SelectExplanation}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource Db.ChooseType}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" />
        <WrapPanel Name="Grade" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
