<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:CofreDeSenhas.Controles"
        x:Class="CofreDeSenhas.Janelas.JanelaSenhaExportacao"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        RenderOptions.BitmapInterpolationMode="HighQuality">

  <Border CornerRadius="{StaticResource RadiusDialogo}"
          ClipToBounds="True"
          Background="{DynamicResource CardBackground}"
          BorderBrush="{DynamicResource CardBorder}"
          BorderThickness="1">

    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="56"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,0,0,1"
              PointerPressed="Arrastar">
        <Grid>
          <TextBlock Name="LblTitulo"
                     Classes="titulo"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="1"
                     Margin="24,0,60,0"
                     TextTrimming="CharacterEllipsis" />
          <Button Classes="fechar-dialogo"
                  AutomationProperties.Name="{DynamicResource Access.Close}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,14,0"
                  Click="Cancelar_Click">
            <Image Width="22" Height="22" Stretch="Uniform" Source="avares://CofreDeSenhas/Ativos/Icones/IconeFechar.png" />
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom"
              Height="72"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
          <Button Name="BtnPrincipal" Classes="primario"
                  MinWidth="140" Height="40" Click="Principal_Click" />
          <Button Classes="secundario" Content="{DynamicResource Common.Cancel}"
                  MinWidth="120" Height="40" Click="Cancelar_Click" />
        </StackPanel>
      </Border>

      <StackPanel Margin="24,18,24,16" Spacing="4">
        <TextBlock Name="LblInfo"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   Margin="0,0,0,12" />

        <TextBlock Name="LblSenha" Classes="legenda" />
        <TextBox Name="TxtSenha" Classes="campo revealPasswordButton" PasswordChar="●" Margin="0,0,0,10"
                 AutomationProperties.HelpText="{DynamicResource A11y.PasswordFieldHelp}"
                 AutomationProperties.IsRequiredForForm="True" />

        <StackPanel Name="PainelConfirmar" Spacing="4">
          <TextBlock Text="{DynamicResource Login.ConfirmPassword}" Classes="legenda" />
          <TextBox Name="TxtConfirmar" Classes="campo revealPasswordButton" PasswordChar="●" Margin="0,0,0,10"
                   AutomationProperties.Name="{DynamicResource Login.ConfirmPassword}"
                   AutomationProperties.HelpText="{DynamicResource A11y.PasswordFieldHelp}"
                   AutomationProperties.IsRequiredForForm="True" />
        </StackPanel>

        <c:MedidorForca Name="Medidor" Margin="0,6,0,2" />

        <TextBlock Name="LblErro"
                   FontSize="12"
                   Foreground="{DynamicResource StrengthWeak}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive"
                   MinHeight="34" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
