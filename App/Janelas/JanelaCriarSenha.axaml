<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:CofreDeSenhas.Controles"
        x:Class="CofreDeSenhas.Janelas.JanelaCriarSenha"
        Title="{DynamicResource Entry.NewTitle}"
        Width="460"
        Height="680"
        MinWidth="460"
        MinHeight="480"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        RenderOptions.BitmapInterpolationMode="HighQuality">

  <Border CornerRadius="{StaticResource RadiusDialogo}"
          ClipToBounds="True"
          Background="{DynamicResource MaterialWorkspace}"
          BorderBrush="{DynamicResource CardBorder}"
          BorderThickness="1">

    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="56"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,0,0,1"
              PointerPressed="Arrastar">
        <Grid>
          <TextBlock Text="{DynamicResource Entry.NewTitle}"
                     Classes="titulo"
                     Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="1"
                     Margin="24,0,60,0"
                     TextTrimming="CharacterEllipsis" />
          <Button Classes="fechar-dialogo"
                  AutomationProperties.Name="{DynamicResource Access.Close}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,14,0"
                  Click="Cancelar_Click">
            <c:Icone Width="{StaticResource TamIconeToolbar}" Height="{StaticResource TamIconeToolbar}" Chave="IconeFechar" />
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom"
              Height="72"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
          <Button Classes="primario" Content="{DynamicResource Common.Save}"
                  MinWidth="140" Height="40" Click="Salvar_Click" />
          <Button Classes="secundario" Content="{DynamicResource Common.Cancel}"
                  MinWidth="120" Height="40" Click="Cancelar_Click" />
        </StackPanel>
      </Border>

      <ScrollViewer Name="ScrollFormulario">
      <StackPanel Margin="24,18,24,16" Spacing="4">
        <TextBlock Text="{DynamicResource Entry.ServiceName}" Classes="legenda" />
        <TextBox Name="TxtNomeServico" Classes="campo" Margin="0,0,0,14"
                 AutomationProperties.Name="{DynamicResource Entry.ServiceName}"
                 AutomationProperties.IsRequiredForForm="True" />

        <TextBlock Text="{DynamicResource Entry.Type}" Classes="legenda" />
        <ComboBox Name="CmbTipo" Classes="campo" HorizontalAlignment="Stretch" Margin="0,0,0,14"
                  AutomationProperties.Name="{DynamicResource Entry.Type}" />

        <TextBlock Name="LblUsuario" Text="{DynamicResource Entry.UserEmail}" Classes="legenda" />
        <TextBox Name="TxtUsuario" Classes="campo" Margin="0,0,0,14"
                 AutomationProperties.Name="{DynamicResource Entry.UserEmail}"
                 AutomationProperties.IsRequiredForForm="True" />

        <TextBlock Name="LblSenha" Text="{DynamicResource Entry.Password}" Classes="legenda" />
        <Panel>
          <TextBox Name="TxtSenha" Classes="campo" PasswordChar="●" Margin="0,0,0,14"
                   AutomationProperties.Name="{DynamicResource Entry.Password}"
                   AutomationProperties.HelpText="{DynamicResource A11y.PasswordFieldHelp}"
                   AutomationProperties.IsRequiredForForm="True" />

          <!-- Sugestão de senha forte ao clicar no campo. Os botões não recebem foco
               de propósito: assim o clique não tira o foco do TxtSenha (o que fecharia
               o popup antes do Click chegar). Teclado: Enter usa, Esc fecha. -->
          <Popup Name="PopupSugestaoSenha"
                 Placement="BottomEdgeAlignedLeft"
                 VerticalOffset="4"
                 IsLightDismissEnabled="False">
            <Border Name="BordaSugestaoSenha"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    BoxShadow="0 8 24 0 #40000000">
              <Grid ColumnDefinitions="*,Auto">
                <Button Name="BtnUsarSugestaoSenha" Classes="cartao" Focusable="False"
                        BorderThickness="0" Padding="10,8"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{DynamicResource Entry.SuggestPassword}"
                        Click="UsarSugestaoSenha_Click">
                  <Grid ColumnDefinitions="Auto,*">
                    <c:Icone Width="{StaticResource TamIconeCampo}" Height="{StaticResource TamIconeCampo}"
                             Chave="IconeChaveGerador" Stroke="{DynamicResource AccentText}"
                             VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                      <TextBlock Text="{DynamicResource Entry.SuggestPassword}"
                                 FontWeight="SemiBold" FontSize="13"
                                 Foreground="{DynamicResource TextPrimary}" />
                      <TextBlock Name="LblSugestaoSenha"
                                 FontFamily="{DynamicResource FonteMono}" FontSize="12"
                                 Foreground="{DynamicResource TextSecondary}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Grid.Column="1" Classes="icone-linha" Focusable="False"
                        Width="32" Height="32" Margin="4,0,2,0" VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource Entry.SuggestPasswordAnother}"
                        ToolTip.Tip="{DynamicResource Entry.SuggestPasswordAnother}"
                        Click="NovaSugestaoSenha_Click">
                  <c:Icone Width="{StaticResource TamIconeCampo}" Height="{StaticResource TamIconeCampo}"
                           Chave="IconeGerar" />
                </Button>
              </Grid>
            </Border>
          </Popup>
        </Panel>

        <StackPanel Name="PainelCamposExtras" Spacing="4" />

        <TextBlock Text="{DynamicResource Entry.TotpOptional}" Classes="legenda" />
        <TextBox Name="TxtTotp" Classes="campo"
                 AutomationProperties.Name="{DynamicResource Entry.TotpOptional}"
                 AutomationProperties.HelpText="{DynamicResource A11y.OptionalField}"
                 Watermark="{DynamicResource Entry.TotpWatermark}" Margin="0,0,0,14" />
        <Border Name="PainelTotp" IsVisible="False"
                Background="{DynamicResource InputBackground}"
                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusInput}" Padding="12,8" Margin="0,0,0,14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Name="LblCodigoTotp" FontFamily="{DynamicResource FonteMono}"
                       FontSize="20" FontWeight="SemiBold" LetterSpacing="1"
                       Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"
                       AutomationProperties.Name="{DynamicResource A11y.TotpPreview}"
                       AutomationProperties.LiveSetting="Polite" />
            <Grid Grid.Column="2" Width="26" Height="26" VerticalAlignment="Center">
              <Ellipse Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Stroke="{DynamicResource TrailInactive}" StrokeThickness="2.5" />
              <Path Name="AnelTotp" Stroke="{DynamicResource AccentPrimary}"
                    StrokeThickness="2.5" StrokeLineCap="Round" />
            </Grid>
          </Grid>
        </Border>

        <TextBlock Text="{DynamicResource Entry.Category}" Classes="legenda" />
        <ComboBox Name="CmbCategoria" Classes="campo" HorizontalAlignment="Stretch" Margin="0,0,0,14"
                  AutomationProperties.Name="{DynamicResource Entry.Category}"
                  AutomationProperties.IsRequiredForForm="True" />

        <TextBlock Text="{DynamicResource Entry.TagsOptional}" Classes="legenda" />
        <TextBox Name="TxtEtiquetas" Classes="campo"
                 AutomationProperties.Name="{DynamicResource Entry.TagsOptional}"
                 AutomationProperties.HelpText="{DynamicResource A11y.OptionalField}"
                 Watermark="{DynamicResource Entry.TagsWatermark}" Margin="0,0,0,14" />

        <TextBlock Text="{DynamicResource Entry.UrlOptional}" Classes="legenda" />
        <TextBox Name="TxtUrl" Classes="campo" Margin="0,0,0,14"
                 AutomationProperties.Name="{DynamicResource Entry.UrlOptional}"
                 AutomationProperties.HelpText="{DynamicResource A11y.OptionalField}" />

        <TextBlock Text="{DynamicResource Entry.NotesOptional}" Classes="legenda" />
        <TextBox Name="TxtNotas" Classes="campo" AcceptsReturn="True" Height="64"
                 AutomationProperties.Name="{DynamicResource Entry.NotesOptional}"
                 AutomationProperties.HelpText="{DynamicResource A11y.OptionalField}" />
      </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
