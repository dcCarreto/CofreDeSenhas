<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:CofreDeSenhas.Controles"
             x:Class="CofreDeSenhas.Controles.GeradorSenha">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18,0,18,18">
      <TextBlock Name="LblCabecalho" Classes="titulo"
                 Text="{DynamicResource Generator.Title}"
                 Foreground="{DynamicResource TextPrimary}"
                 AutomationProperties.HeadingLevel="2"
                 Margin="0,20,0,16" />

      <Grid ColumnDefinitions="*,140" Margin="0,8,0,16">
        <TextBlock Text="{DynamicResource Generator.Mode}" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center" />
        <ComboBox Name="CmbModoGerador" Grid.Column="1" Classes="campo"
                  AutomationProperties.Name="{DynamicResource Generator.Mode}"
                  VerticalAlignment="Center" HorizontalAlignment="Stretch" />
      </Grid>

      <Border MinHeight="64"
              CornerRadius="11"
              Background="{DynamicResource InputBackground}"
              BorderBrush="{DynamicResource InputBorder}"
              BorderThickness="1"
              Margin="0,0,0,20">
        <StackPanel Margin="10,10,10,10" Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Name="TxtSenhaGerada"
                     Classes="embutido"
                     FontFamily="{StaticResource FonteMono}"
                     FontSize="18" FontWeight="Bold"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="36"
                     VerticalAlignment="Top"
                     VerticalContentAlignment="Top"
                     AutomationProperties.Name="{DynamicResource A11y.GeneratedPassword}"
                     AutomationProperties.HelpText="{DynamicResource A11y.GeneratedPasswordHelp}"
                     Margin="0,0,10,0" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Top">
              <Button Classes="icone" Width="32" Height="32"
                      AutomationProperties.Name="{DynamicResource Row.RevealPassword}"
                      Click="OlhoGerada_Click">
                <c:Icone Width="{StaticResource TamIconeCampo}" Height="{StaticResource TamIconeCampo}"
                       Chave="IconeRevelar" />
              </Button>
              <Button Classes="icone" Width="32" Height="32"
                      AutomationProperties.Name="{DynamicResource Row.CopyPassword}"
                      Click="CopiarGerada_Click">
                <c:Icone Width="{StaticResource TamIconeCampo}" Height="{StaticResource TamIconeCampo}"
                       Chave="IconeCopiar" />
              </Button>
              <Button Classes="icone" Width="32" Height="32" FontSize="16"
                      AutomationProperties.Name="{DynamicResource Generator.GeneratePassword}"
                      Click="Gerar_Click">
                <c:Icone Width="{StaticResource TamIconeCampo}" Height="{StaticResource TamIconeCampo}"
                       Chave="IconeGerar" />
              </Button>
            </StackPanel>
          </Grid>

          <StackPanel Name="PainelGeradas" IsVisible="False" />
        </StackPanel>
      </Border>

      <c:MedidorForca Name="Medidor" Margin="0,0,0,22" />

      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
        <TextBlock Text="{DynamicResource Generator.Quantity}" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
        <TextBlock Name="LblQuantidadeValor" Grid.Column="1" Text="1"
                   FontFamily="{StaticResource FonteMono}" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource AccentText}" />
      </Grid>
      <c:CustomSlider Name="SliderQuantidade" Minimum="1" Maximum="10" Value="1" Margin="0,0,0,18"
                      AutomationProperties.Name="{DynamicResource Generator.Quantity}" />

      <StackPanel Name="PainelSenhaCaracteres">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock Text="{DynamicResource Generator.Length}" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
          <TextBlock Name="LblTamanhoValor" Grid.Column="1" Text="12"
                     FontFamily="{StaticResource FonteMono}" FontSize="13" FontWeight="Bold"
                     Foreground="{DynamicResource AccentText}" />
        </Grid>
        <c:CustomSlider Name="SliderTamanho" Minimum="4" Maximum="64" Value="12" Margin="0,0,0,18"
                        AutomationProperties.Name="{DynamicResource Generator.Length}" />

        <Grid ColumnDefinitions="24,*,Auto" Height="30" Margin="0,0,0,6">
          <c:Icone Width="{StaticResource TamIconeToggle}" Height="{StaticResource TamIconeToggle}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Chave="IconeLetraMaiuscula" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Generator.Uppercase}" FontSize="13"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
          <c:CustomToggle Name="ToggleMaiusculas" Grid.Column="2" Checked="True" VerticalAlignment="Center"
                          AutomationProperties.Name="{DynamicResource Generator.Uppercase}" />
        </Grid>
        <Grid ColumnDefinitions="24,*,Auto" Height="30" Margin="0,0,0,6">
          <c:Icone Width="{StaticResource TamIconeToggle}" Height="{StaticResource TamIconeToggle}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Chave="IconeLetraMinuscula" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Generator.Lowercase}" FontSize="13"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
          <c:CustomToggle Name="ToggleMinusculas" Grid.Column="2" Checked="True" VerticalAlignment="Center"
                          AutomationProperties.Name="{DynamicResource Generator.Lowercase}" />
        </Grid>
        <Grid ColumnDefinitions="24,*,Auto" Height="30" Margin="0,0,0,6">
          <c:Icone Width="{StaticResource TamIconeToggle}" Height="{StaticResource TamIconeToggle}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Chave="IconeNumeros" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Generator.Numbers}" FontSize="13"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
          <c:CustomToggle Name="ToggleNumeros" Grid.Column="2" Checked="True" VerticalAlignment="Center"
                          AutomationProperties.Name="{DynamicResource Generator.Numbers}" />
        </Grid>
        <Grid ColumnDefinitions="24,*,Auto" Height="30" Margin="0,0,0,22">
          <c:Icone Width="{StaticResource TamIconeToggle}" Height="{StaticResource TamIconeToggle}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Chave="IconeEspeciais" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Generator.Special}" FontSize="13"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
          <c:CustomToggle Name="ToggleEspeciais" Grid.Column="2" VerticalAlignment="Center"
                          AutomationProperties.Name="{DynamicResource Generator.Special}" />
        </Grid>
      </StackPanel>

      <StackPanel Name="PainelFraseSenha" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock Text="{DynamicResource Generator.Words}" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
          <TextBlock Name="LblPalavrasValor" Grid.Column="1" Text="5"
                     FontFamily="{StaticResource FonteMono}" FontSize="13" FontWeight="Bold"
                     Foreground="{DynamicResource AccentText}" />
        </Grid>
        <c:CustomSlider Name="SliderPalavras" Minimum="3" Maximum="8" Value="5" Margin="0,0,0,18"
                        AutomationProperties.Name="{DynamicResource Generator.Words}" />

        <Grid ColumnDefinitions="*,140" Margin="0,0,0,8">
          <TextBlock Text="{DynamicResource Generator.Separator}" FontSize="13"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
          <ComboBox Name="CmbSeparadorFrase" Grid.Column="1" Classes="campo"
                    AutomationProperties.Name="{DynamicResource Generator.Separator}"
                    VerticalAlignment="Center" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid ColumnDefinitions="24,*,Auto" Height="30" Margin="0,0,0,6">
          <c:Icone Width="{StaticResource TamIconeToggle}" Height="{StaticResource TamIconeToggle}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Chave="IconeCapitalizar" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Generator.Capitalize}" FontSize="13"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
          <c:CustomToggle Name="ToggleCapitalizarFrase" Grid.Column="2" VerticalAlignment="Center"
                          AutomationProperties.Name="{DynamicResource Generator.Capitalize}" />
        </Grid>
        <Grid ColumnDefinitions="24,*,Auto" Height="30" Margin="0,0,0,22">
          <c:Icone Width="{StaticResource TamIconeToggle}" Height="{StaticResource TamIconeToggle}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Chave="IconeNumeros" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Generator.AddNumber}" FontSize="13"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
          <c:CustomToggle Name="ToggleNumeroFrase" Grid.Column="2" Checked="True" VerticalAlignment="Center"
                          AutomationProperties.Name="{DynamicResource Generator.AddNumber}" />
        </Grid>
      </StackPanel>

      <Button Name="BtnGerar" Classes="primario" Height="44"
              HorizontalAlignment="Stretch" Margin="0,0,0,12"
              AutomationProperties.Name="{DynamicResource Generator.GeneratePassword}"
              Click="Gerar_Click">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:Icone Width="{StaticResource TamIconeCampo}" Height="{StaticResource TamIconeCampo}" Stroke="White"
                 Chave="IconeGerar" />
          <TextBlock Text="{DynamicResource Generator.GeneratePassword}" />
        </StackPanel>
      </Button>

      <Grid Name="PainelAcoes" ColumnDefinitions="*,10,90">
        <Button Name="BtnSalvar" Classes="secundario" Height="38" FontSize="13"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{DynamicResource Generator.SaveToVault}"
                Click="SalvarNoCofre_Click">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <c:Icone Width="{StaticResource TamIconeCampo}" Height="{StaticResource TamIconeCampo}"
                   Chave="IconeCadeado" />
            <TextBlock Text="{DynamicResource Generator.SaveToVault}" />
          </StackPanel>
        </Button>
        <Button Name="BtnLimpar" Grid.Column="2" Classes="plano" Height="38"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{DynamicResource Generator.Clear}"
                Click="Limpar_Click">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icone Width="{StaticResource TamIconeCampo}" Height="{StaticResource TamIconeCampo}"
                   Chave="IconeExcluir" />
            <TextBlock Text="{DynamicResource Generator.Clear}" />
          </StackPanel>
        </Button>
      </Grid>

    </StackPanel>
  </ScrollViewer>
</UserControl>
