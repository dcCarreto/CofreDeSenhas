      <SolidColorBrush x:Key="CategoryOtherFg" Color="#5B5F6B" />
      <SolidColorBrush x:Key="CategoryOtherBg" Color="#EDEEF1" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="TextOnAccent" Color="#000000" />
  <SolidColorBrush x:Key="StrengthStrong" Color="#6CCB5F" />
  <SolidColorBrush x:Key="StrengthExcellent" Color="#60CDFF" />
  <SolidColorBrush x:Key="CloseButtonHover" Color="#C42B1C" />
  <SolidColorBrush x:Key="CloseButtonPressed" Color="#A52313" />
  <SolidColorBrush x:Key="FavoriteColor" Color="#F7C948" />
  <SolidColorBrush x:Key="StatusLocal" Color="#6CCB5F" />
  <SolidColorBrush x:Key="StatusWarning" Color="#F2C14E" />
  <SolidColorBrush x:Key="StatusConnected" Color="#60CDFF" />

  <FontFamily x:Key="FonteMono">Cascadia Mono, Consolas, DejaVu Sans Mono, Liberation Mono, Noto Sans Mono, Ubuntu Mono, monospace</FontFamily>
  <FontFamily x:Key="FontePadrao">Segoe UI Variable Text, Segoe UI, Inter</FontFamily>
  <FontFamily x:Key="FonteDisplay">Segoe UI Variable Display, Segoe UI, Inter</FontFamily>

  <x:Double x:Key="TamDisplay">26</x:Double>
  <x:Double x:Key="TamTitulo">21</x:Double>
  <x:Double x:Key="TamSubtitulo">15</x:Double>
  <x:Double x:Key="TamCorpo">14.5</x:Double>
  <x:Double x:Key="TamRotulo">12.5</x:Double>
  <x:Double x:Key="TamLegenda">12</x:Double>
  <x:Double x:Key="TamBotao">14.5</x:Double>
  <x:Double x:Key="TamMonoCorpo">15</x:Double>
  <x:Double x:Key="TamMonoDisplay">22</x:Double>

  <CornerRadius x:Key="RadiusBotao">4</CornerRadius>
  <CornerRadius x:Key="RadiusIcone">4</CornerRadius>
  <CornerRadius x:Key="RadiusCartao">8</CornerRadius>
  <CornerRadius x:Key="RadiusInput">4</CornerRadius>
  <CornerRadius x:Key="RadiusNavItem">4</CornerRadius>
  <CornerRadius x:Key="RadiusDialogo">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <x:Double x:Key="EspacoXs">8</x:Double>
  <x:Double x:Key="EspacoSm">14</x:Double>
  <x:Double x:Key="EspacoMd">20</x:Double>
  <x:Double x:Key="EspacoLg">24</x:Double>

  <x:Double x:Key="AlturaCampo">44</x:Double>
  <x:Double x:Key="AlturaNavItem">44</x:Double>

  <x:Double x:Key="TamIconeSm">28</x:Double>
  <x:Double x:Key="TamIconeMd">36</x:Double>
  <x:Double x:Key="TamIconeLg">44</x:Double>

  <x:Double x:Key="TamIconeNav">20</x:Double>
  <x:Double x:Key="TamIconeToolbar">18</x:Double>
  <x:Double x:Key="TamIconeMenu">18</x:Double>
  <x:Double x:Key="TamIconeCampo">18</x:Double>
  <x:Double x:Key="TamIconeToggle">16</x:Double>
  <x:Double x:Key="TamIconeRodape">14</x:Double>
  <x:Double x:Key="TamIconeVazio">56</x:Double>
  <x:Double x:Key="TamIconeHero">30</x:Double>
  <x:Double x:Key="TamTileHero">64</x:Double>

  <x:Double x:Key="LarguraBotaoRodape">120</x:Double>
  <x:Double x:Key="LarguraBotaoRodapePrimario">140</x:Double>

  <BoxShadows x:Key="CardShadow">0 0 0 0 #00000000</BoxShadows>
  <BoxShadows x:Key="DialogShadow">0 8 24 -4 #47000000</BoxShadows>
  <BoxShadows x:Key="FabShadow">0 3 16 -2 #4DC8A24C</BoxShadows>

  <x:Double x:Key="EspacamentoTexto">0</x:Double>
  <Thickness x:Key="EspessuraFoco">2</Thickness>
  <Thickness x:Key="MargemFoco">-4</Thickness>
  <SolidColorBrush x:Key="CorFoco" Color="#C8A24C" />
  <TextDecorationCollection x:Key="SublinhadoLink" />
</ResourceDictionary>
