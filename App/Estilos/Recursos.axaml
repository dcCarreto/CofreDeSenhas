<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://CofreDeSenhas/Icones.axaml" />
  </ResourceDictionary.MergedDictionaries>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="WorkspaceBackground" Color="#202020" />
      <SolidColorBrush x:Key="CardBackground" Color="#2B2B2B" />
      <SolidColorBrush x:Key="CardBorder" Color="#3A3A3A" />
      <SolidColorBrush x:Key="TitleBar" Color="#1C1C1C" />
      <SolidColorBrush x:Key="TitleBarBorder" Color="#2F2F2F" />
      <SolidColorBrush x:Key="InputBackground" Color="#2D2D2D" />
      <SolidColorBrush x:Key="InputBorder" Color="#474747" />
      <SolidColorBrush x:Key="RowHover" Color="#333333" />
      <SolidColorBrush x:Key="Separator" Color="#353535" />
      <SolidColorBrush x:Key="Footer" Color="#262626" />
      <SolidColorBrush x:Key="AccentPrimary" Color="#60CDFF" />
      <SolidColorBrush x:Key="AccentHover" Color="#4CC2FF" />
      <SolidColorBrush x:Key="AccentLight" Color="#2A3A44" />
      <SolidColorBrush x:Key="AccentText" Color="#99EBFF" />
      <SolidColorBrush x:Key="StrengthWeak" Color="#FF99A4" />
      <SolidColorBrush x:Key="StrengthMedium" Color="#F2C14E" />
      <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextSecondary" Color="#C8C8C8" />
      <SolidColorBrush x:Key="TextTertiary" Color="#A0A0A0" />
      <SolidColorBrush x:Key="TextHeader" Color="#A0A0A0" />
      <SolidColorBrush x:Key="TrailInactive" Color="#404040" />
      <SolidColorBrush x:Key="ToggleOff" Color="#5C5C5C" />
      <SolidColorBrush x:Key="HoverBackground" Color="#323232" />
      <SolidColorBrush x:Key="IconHoverBackground" Color="#383838" />
      <SolidColorBrush x:Key="FavoriteBorderColor" Color="#6E6E6E" />
      <SolidColorBrush x:Key="CategoryWorkFg" Color="#8C9AE8" />
      <SolidColorBrush x:Key="CategoryWorkBg" Color="#262A47" />
      <SolidColorBrush x:Key="CategoryPersonalFg" Color="#E8A468" />
      <SolidColorBrush x:Key="CategoryPersonalBg" Color="#3A2A18" />
      <SolidColorBrush x:Key="CategoryFinanceFg" Color="#4ECB86" />
      <SolidColorBrush x:Key="CategoryFinanceBg" Color="#1B3327" />
      <SolidColorBrush x:Key="CategorySocialFg" Color="#E888AC" />
      <SolidColorBrush x:Key="CategorySocialBg" Color="#3A2230" />
      <SolidColorBrush x:Key="CategoryOtherFg" Color="#A8ACBA" />
      <SolidColorBrush x:Key="CategoryOtherBg" Color="#2A2C33" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WorkspaceBackground" Color="#F3F3F3" />
      <SolidColorBrush x:Key="CardBackground" Color="#FBFBFB" />
      <SolidColorBrush x:Key="CardBorder" Color="#E3E3E3" />
      <SolidColorBrush x:Key="TitleBar" Color="#EEEEEE" />
      <SolidColorBrush x:Key="TitleBarBorder" Color="#E0E0E0" />
      <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="InputBorder" Color="#CFCFCF" />
      <SolidColorBrush x:Key="RowHover" Color="#F0F0F0" />
      <SolidColorBrush x:Key="Separator" Color="#E6E6E6" />
      <SolidColorBrush x:Key="Footer" Color="#F5F5F5" />
      <SolidColorBrush x:Key="AccentPrimary" Color="#005FB8" />
      <SolidColorBrush x:Key="AccentHover" Color="#004C93" />
      <SolidColorBrush x:Key="AccentLight" Color="#E1ECF6" />
      <SolidColorBrush x:Key="AccentText" Color="#003E92" />
      <SolidColorBrush x:Key="StrengthWeak" Color="#C42B1C" />
      <SolidColorBrush x:Key="StrengthMedium" Color="#9D5D00" />
      <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B" />
      <SolidColorBrush x:Key="TextSecondary" Color="#5D5D5D" />
      <SolidColorBrush x:Key="TextTertiary" Color="#6E6E6E" />
      <SolidColorBrush x:Key="TextHeader" Color="#6E6E6E" />
      <SolidColorBrush x:Key="TrailInactive" Color="#D6D6D6" />
      <SolidColorBrush x:Key="ToggleOff" Color="#8A8A8A" />
      <SolidColorBrush x:Key="HoverBackground" Color="#EDEDED" />
      <SolidColorBrush x:Key="IconHoverBackground" Color="#E8E8E8" />
      <SolidColorBrush x:Key="FavoriteBorderColor" Color="#A0A0A0" />
      <SolidColorBrush x:Key="CategoryWorkFg" Color="#3B4FA0" />
      <SolidColorBrush x:Key="CategoryWorkBg" Color="#E7E9F7" />
      <SolidColorBrush x:Key="CategoryPersonalFg" Color="#A0551C" />
      <SolidColorBrush x:Key="CategoryPersonalBg" Color="#FBEDE0" />
      <SolidColorBrush x:Key="CategoryFinanceFg" Color="#1E7A4C" />
      <SolidColorBrush x:Key="CategoryFinanceBg" Color="#E1F5E9" />
      <SolidColorBrush x:Key="CategorySocialFg" Color="#B23C68" />
