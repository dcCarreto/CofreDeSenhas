<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>CofreDeSenhas</AssemblyName>
    <RootNamespace>CofreDeSenhas</RootNamespace>
    <!-- O produto não tem número de versão; o que sobra é um carimbo de data por
         atualização, só para rastreabilidade e para o atualizador embutido comparar
         "mais nova". O pipeline de release passa -p:Version com a data exata (e o
         sufixo .N quando há mais de uma no mesmo dia); localmente vale a data de hoje. -->
    <Version>$([System.DateTime]::UtcNow.ToString('yyyy.M.d'))</Version>
    <Product>Cofre de Senhas</Product>
    <Authors>Denis Cristino Cantagallo Carreto</Authors>
    <Company>Denis Cristino Cantagallo Carreto</Company>
    <Description>Gerenciador de senhas seguro multiplataforma com criptografia AES-256-GCM, senha mestra e gerador de senhas.</Description>
    <Copyright>Copyright © 2026 Denis Cristino Cantagallo Carreto</Copyright>

    <!-- Ícone do executável no Windows; ignorado no Linux -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Janelas só têm construtor com parâmetros; não usamos o loader dinâmico de XAML -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <!-- Habilita o código exclusivo do Windows Hello (#if WINDOWS) só na TFM -windows -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Ativos\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ajuda\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <!-- A síntese de voz neural só é distribuída para win-x64 e linux-x64; as demais
       RIDs que os meta-pacotes puxam por transitividade só pesam no restore. -->
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x86" Version="1.13.5" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="1.13.5" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-arm64" Version="1.13.5" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-x64" Version="1.13.5" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-arm64" Version="1.13.5" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-x64" Version="1.13.5" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-arm64" Version="1.13.5" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.linux-aarch64" Version="1.0.6" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.osx-x64" Version="1.0.6" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.osx-arm64" Version="1.0.6" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GerenciadorDeSenhas.Core\GerenciadorDeSenhas.Core.csproj" />
    <ProjectReference Include="..\GerenciadorDeSenhas.Integracoes\GerenciadorDeSenhas.Integracoes.csproj" />
  </ItemGroup>

</Project>
